{
  "name": "ai-arena",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "AI Arena — self-updating frontier model tracker with reality-corrected leaderboard and deterministic Smart Report dispatch.",
  "scripts": {
    "dev": "concurrently -k -n VITE,API -c magenta,cyan \"vite\" \"node server/dev-server.mjs\"",
    "dev:front": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "vite build",
    "preview": "vite preview",
    "score": "tsx scripts/score-models.ts",
    "update-data": "tsx scripts/update-data.ts",
    "validate": "tsx scripts/validate-ranks.ts",
    "test:dispatch": "node server/dev-server.mjs --self-test",
    "send-digest": "tsx scripts/send-digest.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "nodemailer": "^6.9.14",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
