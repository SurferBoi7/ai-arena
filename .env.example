# =============================================================================
# AI Arena — local dispatch + GitHub Actions secrets
# =============================================================================
# Copy this file to `.env` and fill in to send digests to REAL inboxes.
# Without these, the dev server falls back to a zero-config Ethereal test
# inbox (still a real, viewable email — just not your personal inbox).
#
# The SAME variable names are used as GitHub Actions repository secrets, so
# configuring them once works for both local and production dispatch.
# =============================================================================

# SMTP host of your provider. Free options:
#   - Gmail: smtp.gmail.com  (use a Google App Password, not your password)
#   - Brevo:  smtp-relay.brevo.com  (300 emails/day free)
#   - Mailtrap, Resend, AWS SES, etc.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false

# Credentials. For Gmail: enable 2FA, then create an App Password.
SMTP_USER=
SMTP_PASS=

# From address. Most providers require this to match your authenticated account.
SMTP_FROM="AI Arena <you@example.com>"

# Optional: override the local dev dispatch port (default 8787)
# DISPATCH_PORT=8787
